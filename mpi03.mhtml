@charset "utf-8";

:root { --b: #2457d6; --ink: #182238; --line: #dce4f1; --soft: #f2f6ff; }

* { box-sizing: border-box; }

body { margin: 0px; background: rgb(246, 248, 252); color: var(--ink); font=
-family: "Malgun Gothic", "Apple SD Gothic Neo", sans-serif; line-height: 1=
.65; }

header { background: linear-gradient(135deg, rgb(20, 43, 101), rgb(52, 120,=
 229)); color: rgb(255, 255, 255); padding: 38px 20px; }

.wrap { max-width: 1180px; margin: auto; }

h1 { margin: 0px; font-size: 2.15rem; }

.lead { max-width: 900px; }

.toolbar { position: sticky; top: 0px; z-index: 9; background: rgb(255, 255=
, 255); border-bottom: 1px solid var(--line); padding: 10px 18px; }

.tools { max-width: 1180px; margin: auto; display: flex; gap: 8px; flex-wra=
p: wrap; }

.tools input, .tools select { padding: 10px; border: 1px solid rgb(185, 199=
, 221); border-radius: 8px; min-width: 220px; }

button { padding: 10px 14px; border: 0px; border-radius: 8px; background: v=
ar(--b); color: white; cursor: pointer; }

main { max-width: 1180px; margin: 20px auto; padding: 0px 18px; }

.intro, .card { background: rgb(255, 255, 255); border-radius: 13px; box-sh=
adow: rgba(21, 37, 75, 0.07) 0px 2px 9px; }

.intro { padding: 22px; margin-bottom: 20px; }

.group { margin: 30px 0px 12px; color: rgb(24, 62, 150); border-bottom: 3px=
 solid rgb(219, 231, 255); padding-bottom: 7px; }

.grid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); =
gap: 14px; }

.card { padding: 19px; position: relative; overflow: hidden; }

.card h3 { margin: 0px 0px 7px; padding-right: 50px; color: rgb(23, 63, 159=
); }

.num { position: absolute; right: 14px; top: 13px; font-weight: bold; color=
