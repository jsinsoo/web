@charset "utf-8";

:root { --blue: #2458d3; --ink: #182238; --line: #dbe4f2; --soft: #eef4ff; =
--green: #08765a; }

* { box-sizing: border-box; }

body { margin: 0px; background: rgb(246, 248, 252); color: var(--ink); font=
-family: "Malgun Gothic", "Apple SD Gothic Neo", sans-serif; line-height: 1=
.72; }

header { background: linear-gradient(135deg, rgb(20, 43, 100), rgb(55, 124,=
 229)); color: rgb(255, 255, 255); padding: 42px 20px; }

.wrap { max-width: 1200px; margin: auto; }

h1 { margin: 0px 0px 8px; font-size: 2.15rem; }

.toolbar { position: sticky; top: 0px; z-index: 10; background: rgb(255, 25=
5, 255); border-bottom: 1px solid var(--line); padding: 10px 18px; }

.tools { max-width: 1200px; margin: auto; display: flex; gap: 8px; flex-wra=
p: wrap; }

input, select { padding: 10px; border: 1px solid rgb(185, 199, 220); border=
-radius: 8px; min-width: 230px; }

button { border: 0px; border-radius: 8px; background: var(--blue); color: r=
gb(255, 255, 255); padding: 10px 14px; cursor: pointer; }

main { max-width: 1200px; margin: 20px auto; padding: 0px 18px; }

.intro, .card { background: rgb(255, 255, 255); border-radius: 14px; box-sh=
adow: rgba(23, 35, 58, 0.07) 0px 2px 10px; }

.intro { padding: 24px; margin-bottom: 18px; }

.formula, .math { background: rgb(249, 251, 255); border-left: 5px solid va=
r(--blue); padding: 9px 13px; overflow: auto; }

.notice { background: rgb(255, 248, 223); border: 1px solid rgb(237, 218, 1=
45); padding: 13px; border-radius: 9px; }

.grid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); =
gap: 15px; }

.card { padding: 20px; position: relative; }

.card h3 { margin: 0px 45px 7px 0px; color: rgb(23, 63, 152); }

.n { position: absolute; right: 15px; top: 15px; font-weight: 700; color: r=
gb(123, 135, 155); }

.pill { display: inline-block; background: var(--soft); border-radius: 999p=
x; padding: 2px 9px; font-size: 0.84rem; margin: 0px 4px 7px 0px; }

.use { background: rgb(237, 249, 245); color: rgb(7, 95, 73); }

details { border-top: 1px solid var(--line); padding-top: 8px; }

summary { cursor: pointer; color: rgb(36, 88, 211); font-weight: 700; }

@media (max-width: 760px) {
  .grid { grid-template-columns: 1fr; }
  h1 { font-size: 1.7rem; }
}

@media print {
  .toolbar { display: none; }
  body { background: rgb(255, 255, 255); }
  .grid { display: block; }
  .card, .intro { box-shadow: none; border: 1px solid rgb(221, 221, 221); b=
reak-inside: avoid; margin: 10px 0px; }
  details { display: block; }
  details > p { display: block; }
}
